# ─────────────────────────────────────────────────────────────────────────────
# mantle-kr-herald — environment
#
# Every line is tagged so you can see at a glance what you actually have to set:
#
#   [REQUIRED]  the command will not run without it
#   [OPTIONAL]  has a working default, or the feature is simply off without it
#   [PICK ONE]  one of a set — see the block's note
#
# Nothing here is needed for the translate / convert / format stages: those never
# call an external API. Setup procedures live in docs/ko/setup/ — this file only
# names the variables. Check your setup with `pnpm doctor`.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1. Always ═══════════════════════════════════════════════════════════════

# [REQUIRED] Where approved artifacts are preserved.
#
# **Start with `local`, and switch to `cloud` once your setup is finished.**
# That is the intended path, not a fallback: in local mode the whole pipeline
# runs — collect, translate, convert, format, review — with no cloud credentials
# at all. Section 3 below stays empty until you are ready. When your Google
# Drive credentials are set and `pnpm doctor` is green, change this one line to
# `cloud` (Lark Drive and the Google Sheet are optional — doctor only warns).
#
#   local — everything stays under output/, including the published documents
#           (output/publish/local/{review,approved}/). **You own that tree**: it
#           is git-ignored, so nothing backs it up for you, and neither
#           `pnpm archive` nor `pnpm clean` bounds it — both leave
#           output/publish/local/ alone (they only touch worksheets and
#           expired output/archive/ folders). Know what lives where
#           (docs/ko/artifacts.md) and prune or back it up yourself.
#   cloud — Google/Lark Drive becomes the record of truth; drive:publish uploads
#           there, the Sheet commands run, and section 3 becomes required.
#           output/ is still your working tree — the Drive copy is the record,
#           not a backup of it.
#
# Never inferred. An unset value fails loudly rather than guessing, because
# guessing wrong sends published work to the wrong place: a cloud operator would
# find their documents sitting in output/ instead of Drive, with drive:publish
# reporting success either way.
#
# Promotion steps: docs/ko/quickstart.md §5.
HERALD_STORAGE_MODE=local

# [REQUIRED] The Postgres connection string that backs the pipeline's record of
# truth — translations, conversions, renderings, deliveries, and every other
# ledger that used to live only under output/ as JSON. A standard libpq URL,
# e.g. postgres://user:pass@host:5432/herald.
DATABASE_URL=

# [REQUIRED] Which database DATABASE_URL points at: production | development.
#
# Never inferred from the URL. A connection string looks exactly the same
# whether it points at your laptop's scratch database or the team's shared
# one, so guessing from it — or defaulting when this is unset — is the one
# failure this must not allow: a wrong guess either strands a day of approvals
# in a database nobody reads, or puts a local experiment on the team's live
# board. You state which one this is; nothing derives it for you.
HERALD_DB_ENV=


# ═══ 2. Collection sources ═══════════════════════════════════════════════════
# Needed in BOTH storage modes, but only for the sources you actually collect
# from. Collecting from X only? Leave the Lark block empty, and vice versa.

# [REQUIRED for `pnpm collect`] twitterapi.io API key (module A — X collection).
TWITTERAPI_IO_KEY=

# [OPTIONAL] The KR official X account handle, no @ (e.g. 0xMantleKR). Used by
# `pnpm tm:measure`/`pnpm collect:reference` (translation-memory backfill) and by
# `pnpm metrics:record` (the official account it measures). Default: 0xMantleKR.
REFERENCE_X_HANDLE=

# [REQUIRED for `pnpm collect-lark`, `pnpm lark:chats`, `pnpm lark:send`]
# Create a custom app in the Lark Developer Console, grant scope
# im:message.history:readonly (or im:message:readonly), and add the app/bot to
# each target group chat. See docs/ko/setup/lark.md.
LARK_APP_ID=
LARK_APP_SECRET=

# [REQUIRED for `pnpm collect-lark`] Comma-separated chat_id(s) to collect from
# (e.g. "Mantle News Announcement & MKT Task 2.0"). Find ids with
# `pnpm lark:chats`, which needs only the app credentials above — so leave this
# empty on first run. `pnpm lark:send` also works without it, but then --chat
# is mandatory rather than defaulting to the first id here.
LARK_CHAT_IDS=

# [OPTIONAL] API base domain. Default: https://open.larksuite.com (Larksuite
# international). Use https://open.feishu.cn for Feishu (China).
LARK_BASE_URL=


# ═══ 3. Cloud mode ═══════════════════════════════════════════════════════════
# Only read when HERALD_STORAGE_MODE=cloud. In local mode, six commands —
# drive:init, sheet:init, targets:list, history:record, impressions:record,
# metrics:record — skip with a message and exit 0, so you can leave the whole
# section empty. drive:publish is not one of them: in local mode it targets the
# filesystem instead of Drive, so it still runs, and it does not need anything
# from this section to do so.

# ── 3a. Google auth — [PICK ONE] method A or B ───────────────────────────────
# Detected automatically: a refresh token means OAuth, otherwise a key file
# means service account. Set this only to force one when both are present.
# Valid values: oauth | service_account
GOOGLE_AUTH_MODE=

# Method A — OAuth. Recommended, and the only option for a personal Gmail
# account: files are owned by YOU, so they use your storage quota.
# Create an OAuth client (type: Desktop app), set the id/secret, then run
# `pnpm google:auth` to mint the refresh token. See docs/ko/setup/google-drive.md.
# [REQUIRED for method A]
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# [OPTIONAL] Space-separated OAuth scopes requested by `pnpm google:auth`.
# Default: https://www.googleapis.com/auth/drive.file (least privilege).
# Widen it only when you need to — the Sheet hub (3c) needs the extra scope:
#   GOOGLE_OAUTH_SCOPE="https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets"
# Changing this has no effect until you re-run `pnpm google:auth`; the token
# already carries the scopes it was minted with. `pnpm doctor --live` prints the
# scopes actually granted.
GOOGLE_OAUTH_SCOPE=

# Method B — Service account. A service account has NO storage quota of its own,
# so it can only upload into a Google Workspace **Shared Drive** (or via
# domain-wide delegation) — never a personal Drive. Leave empty for method A.
# [REQUIRED for method B] Path to the JSON key, e.g. keys/mantle-sa.json
GOOGLE_SA_KEY_FILE=

# ── 3b. Google Drive folders (subsystem D) ───────────────────────────────────
# [REQUIRED for `pnpm drive:publish`] Printed by `pnpm drive:init`, or copied
# from the Drive folder URL.
GDRIVE_REVIEW_FOLDER_ID=
GDRIVE_APPROVED_FOLDER_ID=

# [OPTIONAL] Used by `pnpm drive:init` only. Comma-separated team emails to
# share the folders with as editors. Empty means the folders stay private to you.
GDRIVE_SHARE_EMAILS=

# [OPTIONAL] Name of the parent folder `pnpm drive:init` creates.
# Default: "Mantle KR Herald". review/approved are nested inside it, and sharing
# the parent is what gives the team access (children inherit).
GDRIVE_PARENT_FOLDER_NAME=

# [OPTIONAL] Steering-config backup/share folder (pnpm config:push/pull). `config:push`
# provisions it and prints the id on first run if this is empty.
GDRIVE_CONFIG_FOLDER_ID=

# [OPTIONAL] Operational-state backup folder (pnpm state:push/pull) — everything under
# output/ that re-running the pipeline cannot reproduce: the reviewed Korean text
# (translations and conversions), per-room forks, the send ledgers, and the Drive sync
# ledger. `state:push` prints the exact list with row counts every run, so read that
# rather than counting here. It provisions the folder and prints the id on first run if
# this is empty. Keep it separate from the config folder: it records what THIS machine
# has already sent, so it is a personal backup, not a team share — restoring someone
# else's makes already-sent rooms read as never-sent.
GDRIVE_STATE_FOLDER_ID=

# [OPTIONAL] Sent-rendering archive folder for `pnpm send:channels`. Printed by
# `pnpm drive:init`. Unset means no Google archive copy is written (delivery
# still happens either way).
GDRIVE_SENT_FOLDER_ID=

# ── 3c. Google Sheet — data hub (§9a/§9b) + performance tracker ──────────────
# [REQUIRED for `pnpm sheet:init`, `pnpm targets:list`, `pnpm history:record`,
# `pnpm impressions:record`, `pnpm metrics:record`]
# Spreadsheet id (from the sheet URL, or printed by `pnpm sheet:init`). ONE
# workbook can hold every machine tab: `history` (history:record / send:channels)
# and `x-performance` (metrics:record) each auto-create their tab in whatever this
# id points at, so you can aim GSHEET_ID at your existing team workbook and skip
# sheet:init (which only pre-creates targets+history in a fresh sheet). `targets`
# for targets:list is the one tab you fill by hand. Reuses the Google auth above,
# but the token must carry the spreadsheets scope — see GOOGLE_OAUTH_SCOPE and
# docs/ko/setup/google-drive.md §공통 5.
GSHEET_ID=
# [OPTIONAL] A second workbook for QA. Its front tab is where anyone on the team
# files a request or a bug from using the dashboard; the rest track check status,
# open gaps and a dated change log. Nothing writes to it automatically — it is
# maintained by hand and linked from the dashboard header beside GSHEET_ID. Leave
# blank to hide that link. Same id format as above (from the sheet URL).
GSHEET_QA_ID=

# ── 3d. Lark Drive upload (subsystem D) ──────────────────────────────────────
# [REQUIRED for `pnpm drive:publish --target lark|both`] Reuses the Lark app
# from section 2 — add a drive scope to it. Folder tokens are the last path
# segment of the Lark drive folder URL. Google-only publishing (the default)
# does not need these.
LARK_DRIVE_REVIEW_FOLDER_TOKEN=
LARK_DRIVE_APPROVED_FOLDER_TOKEN=

# [OPTIONAL] Sent-rendering archive folder for `pnpm send:channels`. No
# auto-provisioning for Lark — create a `sent` folder by hand and paste its
# folder token (see the note above). Unset means no Lark archive copy is
# written (delivery still happens either way).
LARK_DRIVE_SENT_FOLDER_TOKEN=

# [OPTIONAL] The Lark workspace (tenant) origin — used only to build "open folder /
# open file in Lark" links in the review dashboard. It is the domain part of a Lark
# drive URL, e.g. https://<tenant>.larksuite.com (origin only, no path). Unset means the
# dashboard shows no Lark links; publishing is unaffected.
LARK_WORKSPACE_URL=


# ═══ 4. Channel delivery (§8) — pnpm send:channels ═══════════════════════════
# Needed in ANY storage mode — these are channel APIs, not cloud Drive. Only for
# the channels you actually send to.

# [REQUIRED for `pnpm send:channels --target telegram`] Bot token from BotFather;
# add the bot to each target room. See docs/ko/setup/channels.md.
TELEGRAM_BOT_TOKEN=
# [REQUIRED for `pnpm send:channels --target telegram`] One chat id per room, so
# two rooms on the same channel stay apart. Invite the bot, post any message in
# the room, then read result[].message.chat.id from
# https://api.telegram.org/bot<TOKEN>/getUpdates — supergroups and channels start
# with -100. A room left blank is skipped, and the dashboard names the missing
# variable. COMMUNITY = 맨틀 한국 커뮤니티, DEV = 맨틀 한국 데브방.
TELEGRAM_CHAT_ID_COMMUNITY=
TELEGRAM_CHAT_ID_DEV=

# [REQUIRED for `pnpm send:channels --target x`] Typefully v2 API key
# (typefully.com → Settings → API) and the social_set_id whose X account is
# @0xMantleKR (list them with GET /v2/social-sets). See docs/ko/setup/channels.md.
# X delivery is bounded by the plan's monthly publishing quota, not the API rate
# limit; run `pnpm doctor --live` to see the remaining count and reset date.
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# [OPTIONAL] Set to true only if the X account you publish to has X Premium. When true, x sends
# allow Premium long-form posts (up to 25,000 chars); when false (the default), they enforce the
# standard 280-weighted tweet limit (Korean/emoji count as 2 each).
X_PREMIUM=


# ═══ 5. Review dashboard — pnpm serve ════════════════════════════════════════

# [OPTIONAL] Port for the review dashboard. Default: 5757.
# The server binds localhost only.
PORT=

# [OPTIONAL] The dashboard's single sign-in account. Both must be set or neither:
# with either one missing, `POST /api/login` refuses every attempt.
#
# Generate the pair with `pnpm auth:hash` — it prompts for the password without
# echoing it and prints the two lines to paste here. Never put the password
# itself in this file; HERALD_AUTH_PASSWORD_HASH is a scrypt hash, and knowing it
# does not get anyone in.
#
# Leave both blank while the dashboard runs on localhost — nothing gates the API
# yet, so an account here changes nothing on its own. They matter once the
# dashboard is reachable from anywhere else. Five failed attempts lock logins for
# one minute, process-wide.
HERALD_AUTH_USERNAME=
HERALD_AUTH_PASSWORD_HASH=

# [REQUIRED] Signs the dashboard's session cookie (HMAC-SHA256) once a login succeeds.
# Generate one with `openssl rand -hex 32` — at least 32 characters, and anyone who
# has it can forge a valid session, so treat it like a password: never commit it, and
# rotate it (which signs everyone out at once) if it ever leaks.
HERALD_SESSION_SECRET=
