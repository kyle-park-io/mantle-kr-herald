# Local-only design/planning material (not committed)
design/

# Secrets
.env*
!.env.example

# Steering config — the example skeletons are tracked, the real team content is not.
# (Untracking does not erase history; see the storage design spec.)
translation/*
!translation/*.example.json
!translation/*.example.md
conversion/*
!conversion/*.example.json
!conversion/*.example.md

# Local keys (Google service account JSON, etc.) — never commit the actual keys
keys/*
!keys/.gitkeep
!keys/README.md

# Dependencies / build
node_modules/
dist/

# Vercel CLI local project link (project/org ids, pulled env)
.vercel

# Agent skills ARE tracked (.agents/, skills-lock.json, the .claude/skills symlinks) — pinned by
# hash so every machine resolves the same ones. Personal Claude Code state is not: this is the
# file the tool writes per-machine permissions into, and tracking .claude/ must not invite it in.
.claude/settings.local.json

# Collector output (local JSON)
output/

# Frontend build output / deps
web/dist/
web/node_modules/

# Playwright MCP session dumps (console logs + page snapshots, timestamped per run)
.playwright-mcp/

# Subagent-driven-development scratch (per-plan ledger, briefs, review packages).
# Working notes for an in-flight plan; git history is the record once the plan lands.
.superpowers/

# Local team work files — NEVER commit (real PII: KOL emails, contract prices, payout tx).
# Public repo; the canonical copy of these belongs outside the repo (Drive), like steering config.
*.xlsx
*.xls
*.numbers
