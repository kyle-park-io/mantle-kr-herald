{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // `tests` holds the component tests, which have to be typechecked under THIS config rather than the
  // root one: they render JSX and touch `document`, and the root tsconfig has neither `jsx` nor the DOM
  // lib (deliberately — `src/` is a Node pipeline). It is also why they live here instead of beside the
  // pure frontend tests in `/tests/web/`, which import plain modules and need neither.
  "include": ["src", "tests"]
}
